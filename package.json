{
  "name": "mcp-doc-processor",
  "version": "1.0.0",
  "description": "MCP server for reading and processing PDF, DOCX, Excel files with intelligent OCR, layout analysis, and document generation capabilities",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "start:http": "node src/server.js",
    "serve:funnel": "tailscale funnel --bg 8443",
    "serve:tailnet": "tailscale serve --bg --https=443 localhost:8443",
    "test": "node test/test-markdown-format-router.js",
    "test:read-doc": "node --test test/test-read-doc.js",
    "test:schemas": "node --test test/test-tool-schemas.js",
    "test:render": "node --test test/test-render-markdown.js",
    "test:upload": "node --test test/test-upload.js",
    "test:http": "node --test test/test-http-transport.js",
    "test:auth": "node --test test/test-auth.js",
    "test:oauth": "node test/test-oauth.js",
    "test:pdf": "node --test test/test-pdf-parse.js",
    "test:create-tags": "node --test test/test-create-doc-tags.js",
    "test:create-pdf": "node --test test/test-create-pdf.js",
    "test:create-pptx": "node --test test/test-create-pptx.js",
    "test:fact-check": "node --test test/test-fact-check.js",
    "test:format-router": "node --test test/test-format-router.js",
    "test:confinement": "node --test test/test-workspace-confinement.js",
    "test:rebinding": "node --test test/test-dns-rebinding.js",
    "test:lifecycle": "node --test test/test-workspace-lifecycle.js",
    "insights": "node scripts/insights-report.mjs",
    "refused": "node scripts/refused-report.mjs",
    "test:refused": "node --test test/test-refused-log.js",
    "test:all": "npm test && npm run test:read-doc && npm run test:schemas && npm run test:render && npm run test:upload && npm run test:http && npm run test:auth && npm run test:oauth && npm run test:pdf && npm run test:create-tags && npm run test:create-pdf && npm run test:create-pptx && npm run test:fact-check && npm run test:format-router && npm run test:confinement && npm run test:rebinding && npm run test:lifecycle && npm run test:refused",
    "lint:no-console-log": "! grep -rn 'console\\.log(' src/ --include='*.js'"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "argon2": "^0.41.1",
    "cors": "^2.8.5",
    "docx": "^9.5.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.4.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.5.4",
    "marked": "^17.0.2",
    "pdf-parse": "^2.4.5",
    "pptxgenjs": "^4.0.1",
    "puppeteer": "^25.16.0",
    "undici": "^7.30.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "xlsx-js-style": "^1.2.0"
  },
  "overrides": {
    "image-size": "^2.0.3"
  }
}
